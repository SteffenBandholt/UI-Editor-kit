<Window x:Class="M79ExistingWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:M79ExistingWpfApp.Views"
        Title="Kontrollierte M79-Bestands-App" Height="620" Width="980">
  <Grid x:Name="RootLayout" Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid x:Name="HeaderArea">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Label x:Name="OrderNumberLabel" Content="Vorgang" />
      <TextBox x:Name="OrderNumberField" Grid.Column="1" Text="TEST-100" Margin="6,0" />
      <TextBlock x:Name="StatusText" Grid.Column="2" Text="Bereit" VerticalAlignment="Center" />
    </Grid>
    <StackPanel x:Name="FilterPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,14">
      <TextBox Width="180" Text="Unbenannte Testnotiz" />
      <CheckBox x:Name="ActiveCheckBox" Content="Aktiv" IsChecked="True" Margin="12,0" />
      <RadioButton x:Name="StandardRadio" GroupName="Mode" Content="Standard" IsChecked="True" Margin="12,0" />
      <RadioButton x:Name="CompactRadio" GroupName="Mode" Content="Kompakt" Margin="12,0" />
    </StackPanel>
    <DataGrid x:Name="ItemsTable" Grid.Row="2" AutoGenerateColumns="False" ItemsSource="{Binding Rows}">
      <DataGrid.Columns>
        <DataGridTextColumn x:Name="CodeColumn" Header="Code" Binding="{Binding Code}" Width="120" />
        <DataGridTextColumn x:Name="DescriptionColumn" Header="Beschreibung" Binding="{Binding Description}" Width="*" />
        <DataGridCheckBoxColumn x:Name="VisibleColumn" Header="Sichtbar" Binding="{Binding Visible}" Width="90" />
        <DataGridTemplateColumn x:Name="ActionColumn" Header="Aktion" Width="100">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="Senden" Command="{Binding DataContext.SendCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel x:Name="BottomArea" Grid.Row="3" Margin="0,14,0,0">
      <views:DetailsView x:Name="DetailsView" DockPanel.Dock="Left" />
      <StackPanel x:Name="ActionsPanel" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="ToggleButton" Content="Anzeige wechseln" Click="ToggleButton_Click" Padding="12,6" Margin="4" />
        <Button x:Name="SaveButton" Content="Fachlich speichern" Click="SaveButton_Click" Padding="12,6" Margin="4" />
        <Button x:Name="ImportButton" Content="Importieren" Command="{Binding ImportCommand}" Padding="12,6" Margin="4" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
