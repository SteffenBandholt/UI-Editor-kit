<Window x:Class="UiEditorKit.Manager.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UI-Editor Manager" Height="760" Width="1180" MinHeight="640" MinWidth="980" WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="190"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <StackPanel DockPanel.Dock="Left"><TextBlock Text="UI-Editor Manager" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Native Verwaltung vorbereiteter UI-/PDF-Ziel-Apps" Foreground="#555"/></StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Ziel-App auswählen" Click="SelectFolder_Click" Padding="15,8" Margin="5"/>
        <Button Content="Projektdatei auswählen" Click="SelectProject_Click" Padding="15,8" Margin="5"/>
        <Button Content="Liste aktualisieren" Click="Refresh_Click" Padding="15,8" Margin="5"/>
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <GroupBox Header="Bekannte Ziel-Apps" Grid.Column="0"><ListBox x:Name="AppsList" DisplayMemberPath="DisplayName" SelectionChanged="AppsList_SelectionChanged"/></GroupBox>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
        <TextBlock Text="Ziel-App-Details" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Text="Projektpfad"/><TextBox x:Name="RootText" Grid.Column="1" IsReadOnly="True"/>
          <TextBlock Text="Projekttyp" Grid.Row="1"/><TextBlock x:Name="ProjectTypeText" Grid.Row="1" Grid.Column="1"/>
          <TextBlock Text="Vertragsstatus" Grid.Row="2"/><TextBlock x:Name="ContractText" Grid.Row="2" Grid.Column="1" FontWeight="SemiBold"/>
          <TextBlock Text="Installationsstatus" Grid.Row="3"/><TextBlock x:Name="InstallText" Grid.Row="3" Grid.Column="1"/>
          <TextBlock Text="Installierte Version" Grid.Row="4"/><TextBlock x:Name="InstalledVersionText" Grid.Row="4" Grid.Column="1"/>
          <TextBlock Text="Verfügbare Paketversion" Grid.Row="5"/><TextBlock x:Name="PackageVersionText" Grid.Row="5" Grid.Column="1"/>
          <TextBlock Text="Letzte Prüfung" Grid.Row="6"/><TextBlock x:Name="CheckedText" Grid.Row="6" Grid.Column="1"/>
          <TextBlock Text="Letzte Aktion" Grid.Row="7"/><TextBlock x:Name="LastActionText" Grid.Row="7" Grid.Column="1"/>
        </Grid>
        <WrapPanel Margin="0,16,0,8">
          <Button Content="Prüfen" Click="Check_Click" Padding="12,7" Margin="3"/>
          <Button x:Name="PreviewButton" Content="Installationsvorschau" Click="Preview_Click" Padding="12,7" Margin="3" IsEnabled="False"/>
          <Button x:Name="InstallButton" Content="Installieren / Aktualisieren" Click="Install_Click" Padding="12,7" Margin="3" IsEnabled="False"/>
          <Button x:Name="UninstallPreviewButton" Content="Deinstallationsvorschau" Click="UninstallPreview_Click" Padding="12,7" Margin="3" IsEnabled="False"/>
          <Button x:Name="UninstallButton" Content="Deinstallieren" Click="Uninstall_Click" Padding="12,7" Margin="3" IsEnabled="False"/>
          <Button x:Name="StartTargetButton" Content="Ziel-App starten" Click="StartTarget_Click" Padding="12,7" Margin="3" IsEnabled="False"/>
          <Button x:Name="StartEditorButton" Content="Editor starten" Click="StartEditor_Click" Padding="12,7" Margin="3" IsEnabled="False"/>
          <Button x:Name="RemoveButton" Content="Eintrag entfernen" Click="Remove_Click" Padding="12,7" Margin="3" IsEnabled="False"/>
        </WrapPanel>
        <GroupBox Header="Bestätigte Vorschau"><DataGrid x:Name="PlanGrid" AutoGenerateColumns="False" IsReadOnly="True" Height="220">
          <DataGrid.Columns><DataGridTextColumn Header="Datei" Binding="{Binding RelativePath}" Width="*"/><DataGridTextColumn Header="Aktion" Binding="{Binding Action}" Width="110"/><DataGridCheckBoxColumn Header="Manager-Eigentum" Binding="{Binding ManagerOwned}" Width="130"/><DataGridTextColumn Header="Konflikt" Binding="{Binding Conflict}" Width="220"/></DataGrid.Columns>
        </DataGrid></GroupBox>
      </StackPanel></ScrollViewer>
    </Grid>
    <GroupBox Grid.Row="2" Header="Protokoll und Fehler" Margin="0,12,0,8"><TextBox x:Name="LogText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></GroupBox>
    <StatusBar Grid.Row="3"><StatusBarItem><TextBlock x:Name="StatusText" Text="Bereit – keine Netzwerkverbindung erforderlich."/></StatusBarItem></StatusBar>
  </Grid>
</Window>
