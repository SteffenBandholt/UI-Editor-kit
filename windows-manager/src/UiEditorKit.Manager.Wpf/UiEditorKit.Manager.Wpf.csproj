<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>UiEditorManager</AssemblyName>
    <Product>UI-Editor Manager</Product>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../UiEditorKit.Manager.Domain/UiEditorKit.Manager.Domain.csproj" />
    <ProjectReference Include="../UiEditorKit.Manager.Core/UiEditorKit.Manager.Core.csproj" />
    <ProjectReference Include="../UiEditorKit.Manager.Infrastructure/UiEditorKit.Manager.Infrastructure.csproj" />
    <ProjectReference Include="../../../reference-target-app/src/ReferenceTargetApp.Wpf/ReferenceTargetApp.Wpf.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../package/current/**/*"><Link>packages/current/%(RecursiveDir)%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content>
    <Content Include="../../../src/**/*.cjs"><Link>editor-runtime/src/%(RecursiveDir)%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content>
    <Content Include="../../../package.json"><Link>editor-runtime/package.json</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory></Content>
  </ItemGroup>
</Project>
