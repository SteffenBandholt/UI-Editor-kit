<Window x:Class="ReferenceTargetApp.UI.Views.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ungespeicherte Änderungen" Width="520" Height="220"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Ungespeicherte Änderungen vorhanden" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="ContextText" Margin="0,12,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Speichern und fortfahren" Click="Save_Click" MinWidth="150" Margin="0,0,8,0" />
            <Button Content="Ohne Speichern fortfahren" Click="Discard_Click" MinWidth="180" Margin="0,0,8,0" />
            <Button Content="Abbrechen" Click="Cancel_Click" MinWidth="95" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
