<Window x:Class="ReferenceTargetApp.UI.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ReferenceTargetApp.UI.Views"
        Title="UI-/PDF-Editor · Gemeinsamer End-to-End-Betrieb"
        Width="1380" Height="900" MinWidth="620" MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <TabControl SelectedIndex="{Binding ActiveWorkspaceIndex, Mode=TwoWay}" Margin="10">
      <TabItem Header="Programmoberfläche">
    <Grid>
      <views:CompactEditorWorkspaceView x:Name="CompactUiWorkspace"/>
    <Grid Margin="8" Visibility="Collapsed">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="220" /><ColumnDefinition Width="24" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Profil:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="ProfileSelector" Grid.Column="1" ItemsSource="{Binding Profiles}" DisplayMemberPath="DisplayName" SelectedValuePath="ProfileId" SelectedValue="{Binding ActiveProfileId, Mode=OneWay}" SelectionChanged="ProfileSelector_SelectionChanged" />
                <TextBlock Grid.Column="3" Text="Bereich:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="ScopeSelector" Grid.Column="4" ItemsSource="{Binding Scopes}" DisplayMemberPath="DisplayName" SelectedValuePath="ScopeId" SelectedValue="{Binding ActiveScopeId, Mode=OneWay}" SelectionChanged="ScopeSelector_SelectionChanged" />
                <TextBlock Grid.Column="5" Text="{Binding DirtyStatus}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#8A4B08" />
            </Grid>
        </Border>

        <GroupBox Grid.Row="1" Grid.Column="0" Header="Registrierte Elemente" Margin="0">
            <TreeView x:Name="ElementTree" ItemsSource="{Binding TreeRoots}" SelectedItemChanged="ElementTree_SelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=OneTime}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </GroupBox>

        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Bearbeitungsmodus">
                    <StackPanel>
                        <WrapPanel>
                            <RadioButton Content="Geführt" GroupName="EditMode" IsChecked="{Binding IsGuidedEditMode, Mode=OneWay}" Command="{Binding SetEditModeCommand}" CommandParameter="guided" Margin="0,0,18,0" />
                            <RadioButton Content="Frei" GroupName="EditMode" IsChecked="{Binding IsFreeEditMode, Mode=OneWay}" Command="{Binding SetEditModeCommand}" CommandParameter="free" />
                        </WrapPanel>
                        <TextBlock Text="{Binding EditModeStatus}" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>
                <GroupBox Header="Elementdetails">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="Name" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Column="1" Text="{Binding SelectedName}" FontWeight="SemiBold" />
                            <TextBlock Grid.Row="1" Text="Position" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Position}" />
                            <TextBlock Grid.Row="2" Text="Größe" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Size}" />
                            <TextBlock Grid.Row="3" Text="Textposition" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TextPosition}" />
                            <TextBlock Grid.Row="4" Text="Schriftgröße" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FontSize}" />
                            <TextBlock Grid.Row="5" Text="Sichtbarkeit" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding VisibilityStatus}" />
                        </Grid>
                        <Expander Header="Details anzeigen" Margin="0,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="Element-ID" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Column="1" Text="{Binding SelectedId}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Text="Art" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedType}" />
                                <TextBlock Grid.Row="2" Text="Scope-ID" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedScope}" />
                                <TextBlock Grid.Row="3" Text="Parent-ID" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedParent}" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="4" Text="Rolle" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedRole}" />
                                <TextBlock Grid.Row="5" Text="Operationen" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Operations}" TextWrapping="Wrap" />
                            </Grid>
                        </Expander>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Bearbeitung">
                    <StackPanel IsEnabled="{Binding ControlsEnabled}">
                        <TextBlock Text="Ebene" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                        <ItemsControl ItemsSource="{Binding Layers}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" IsEnabled="{Binding Enabled}" Command="{Binding DataContext.SetLayerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Active}" Value="True"><Setter Property="Background" Value="{StaticResource PrimaryBrush}" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Modus" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                        <ItemsControl ItemsSource="{Binding Modes}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" IsEnabled="{Binding Enabled}" Command="{Binding DataContext.SetModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Margin="0,0,8,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding Active}" Value="True"><Setter Property="Background" Value="{StaticResource PrimaryBrush}" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="#F1F5F9" BorderBrush="#94A3B8" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,12">
                            <TextBlock Text="{Binding LayoutEffectInfo}" TextWrapping="Wrap" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Schrittweite (DIP)" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Text="{Binding StepText, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                        </StackPanel>
                        <Grid HorizontalAlignment="Left">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="58" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                            <Button Grid.Row="0" Grid.Column="1" Content="↑" IsEnabled="{Binding UpEnabled}" Command="{Binding DirectionCommand}" CommandParameter="up" ToolTip="Nach oben / Höhe oder Schrift vergrößern" Margin="3" />
                            <Button Grid.Row="1" Grid.Column="0" Content="←" IsEnabled="{Binding LeftEnabled}" Command="{Binding DirectionCommand}" CommandParameter="left" ToolTip="Nach links / verkleinern" Margin="3" />
                            <Border Grid.Row="1" Grid.Column="1" Margin="8" Background="#E7EBF1" CornerRadius="4" />
                            <Button Grid.Row="1" Grid.Column="2" Content="→" IsEnabled="{Binding RightEnabled}" Command="{Binding DirectionCommand}" CommandParameter="right" ToolTip="Nach rechts / vergrößern" Margin="3" />
                            <Button Grid.Row="2" Grid.Column="1" Content="↓" IsEnabled="{Binding DownEnabled}" Command="{Binding DirectionCommand}" CommandParameter="down" ToolTip="Nach unten / Höhe oder Schrift verkleinern" Margin="3" />
                        </Grid>
                        <TextBlock Text="Schriftgröße: ← kleiner, → größer. Nicht verwendete Richtungen sind deaktiviert." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <Button Content="{Binding VisibilityActionLabel}" Command="{Binding ToggleVisibilityCommand}" IsEnabled="{Binding CanChangeVisibility}" HorizontalAlignment="Left" Margin="0,12,0,0" MinWidth="120" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Layoutaktionen">
                    <WrapPanel>
                        <Button Content="Speichern" Command="{Binding SaveCommand}" Margin="0,0,8,8" />
                        <Button Content="Laden" Command="{Binding LoadCommand}" Margin="0,0,8,8" />
                        <Button Content="Änderung verwerfen" Command="{Binding DiscardElementCommand}" ToolTip="Ausgewähltes Element zur letzten gespeicherten Profilversion zurück" Margin="0,0,8,8" />
                        <Button Content="Alle Änderungen verwerfen" Command="{Binding DiscardAllCommand}" ToolTip="Gesamtes Working-Layout zur letzten gespeicherten Profilversion zurück" Margin="0,0,8,8" />
                        <Button Content="Element zurücksetzen" Command="{Binding ResetElementCommand}" ToolTip="Ausgewähltes Element zur ursprünglichen Ziel-App-Baseline zurück" Margin="0,0,8,8" />
                        <Button Content="Gesamtes Layout zurücksetzen" Command="{Binding ResetAllCommand}" ToolTip="Alle Scopes zur ursprünglichen Ziel-App-Baseline zurück" Margin="0,0,8,8" />
                    </WrapPanel>
                </GroupBox>

                <GroupBox Header="Auswahl in der Ziel-App">
                    <StackPanel>
                      <StackPanel Orientation="Horizontal">
                        <Button Content="Element in App auswählen" Command="{Binding BeginAppSelectionCommand}" Margin="0,0,8,0" />
                        <Button Content="Auswahl abbrechen" Command="{Binding CancelAppSelectionCommand}" />
                      </StackPanel>
                      <TextBlock Text="{Binding DirectSelectionInfo}" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#A61B1B" TextWrapping="Wrap" />
                    <Expander Header="Details anzeigen" Margin="0,6,0,0">
                        <Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasTechnicalDetails}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Expander.Style>
                        <TextBlock Text="{Binding TechnicalDetails}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                    </Expander>
                </StackPanel>
                <Button Grid.Column="1" Content="Schließen" Command="{Binding CloseCommand}" MinWidth="110" Margin="18,0,0,0" />
            </Grid>
        </Border>
    </Grid>
    </Grid>
      </TabItem>
      <TabItem Header="PDF-Ausgabe" DataContext="{Binding PdfBinding}">
        <Grid>
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="28" Margin="20">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers><DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="PDF-Ausgabe" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding UnavailableMessage}" FontSize="16" Margin="0,16,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="620"/>
          </StackPanel>
        </Border>
        <Grid Margin="8">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers><DataTrigger Binding="{Binding IsAvailable}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="PDF-Profil:" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Grid.Column="1" Text="{Binding ProfileId}" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding DirtyStatus}" FontWeight="SemiBold" Margin="0,0,18,0"/><TextBlock Text="{Binding PreviewStatus}" FontWeight="SemiBold" Foreground="#8A4B08"/></StackPanel>
              <Button Grid.Column="3" Content="Speichern" Command="{Binding SaveCommand}" Margin="10,0,5,0"/>
              <Button Grid.Column="4" Content="Laden" Command="{Binding LoadCommand}" Margin="5,0"/>
              <Button Grid.Column="5" Content="PDF neu erzeugen" Command="{Binding RenderCommand}" Margin="5,0"/>
              <Button Grid.Column="6" Content="Vorschau aktualisieren" Command="{Binding RefreshPreviewCommand}" Margin="5,0,0,0"/>
            </Grid>
          </Border>
          <Grid x:Name="PdfAdaptiveGrid" Grid.Row="1" SizeChanged="PdfAdaptiveGrid_SizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
            <Grid x:Name="PdfSelectionColumn" Grid.Column="0">
              <Grid.RowDefinitions><RowDefinition Height="170"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <GroupBox Header="Seitenübersicht"><ListBox x:Name="PdfPageList" ItemsSource="{Binding Pages}" DisplayMemberPath="Label" SelectionChanged="PdfPageList_SelectionChanged"/></GroupBox>
              <GroupBox Grid.Row="2">
                <GroupBox.Header>
                  <TextBlock>
                    <Run Text="PDF-Elementbaum · "/><Run Text="{Binding RegistryElementCount, Mode=OneWay}"/><Run Text=" registrierte Elemente"/>
                  </TextBlock>
                </GroupBox.Header>
                <TreeView x:Name="PdfElementTree" ItemsSource="{Binding TreeRoots}" SelectedItemChanged="PdfElementTree_SelectedItemChanged">
                  <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="True"/></Style></TreeView.ItemContainerStyle>
                  <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}"><TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis"/></HierarchicalDataTemplate></TreeView.ItemTemplate>
                </TreeView>
              </GroupBox>
            </Grid>
            <GroupBox x:Name="PdfPreviewColumn" Grid.Column="2" Header="Native Vorschau · Seite einpassen">
              <Grid Background="#CBD1DA" ClipToBounds="True" x:Name="PdfPreviewViewport" SizeChanged="PdfPreviewViewport_SizeChanged" MouseLeftButtonDown="PdfPreviewViewport_MouseLeftButtonDown">
                <Border Background="White" BorderBrush="#707783" BorderThickness="1" Margin="14"><Image Source="{Binding SelectedPageImage}" Stretch="Uniform"/></Border>
                <Canvas IsHitTestVisible="False"><Rectangle Stroke="#E03030" StrokeThickness="2" Fill="#20E03030" Canvas.Left="{Binding OverlayLeft}" Canvas.Top="{Binding OverlayTop}" Width="{Binding OverlayWidth}" Height="{Binding OverlayHeight}"/></Canvas>
              </Grid>
            </GroupBox>
            <ScrollViewer x:Name="PdfPropertyColumn" Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel>
                <GroupBox Header="Bearbeitungsmodus">
                  <StackPanel>
                    <WrapPanel>
                      <RadioButton Content="Geführt" GroupName="PdfEditMode" IsChecked="{Binding DataContext.IsGuidedEditMode, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Command="{Binding DataContext.SetEditModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="guided" Margin="0,0,18,0"/>
                      <RadioButton Content="Frei" GroupName="PdfEditMode" IsChecked="{Binding DataContext.IsFreeEditMode, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}" Command="{Binding DataContext.SetEditModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="free"/>
                    </WrapPanel>
                    <TextBlock Text="{Binding DataContext.EditModeStatus, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="PDF-Seitengrenzen, Pagination und Druckbarkeit bleiben in beiden Modi verbindlich." Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                </GroupBox>
                <GroupBox Header="PDF-Elementdetails"><StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                    <TextBlock Text="Name"/><TextBlock Grid.Column="1" Text="{Binding SelectedName}" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="1" Text="Position"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Position}"/>
                    <TextBlock Grid.Row="2" Text="Größe"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Size}"/>
                    <TextBlock Grid.Row="3" Text="Textposition"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TextPosition}"/>
                    <TextBlock Grid.Row="4" Text="Schriftgröße"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FontSize}"/>
                    <TextBlock Grid.Row="5" Text="Seite"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedPageText}"/>
                    <TextBlock Grid.Row="6" Text="Tabelle"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding TableInfo}" TextWrapping="Wrap"/>
                  </Grid>
                  <Expander Header="Details anzeigen" Margin="0,8,0,0">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                      <TextBlock Text="Element-ID"/><TextBlock Grid.Column="1" Text="{Binding SelectedId}" TextWrapping="Wrap"/>
                      <TextBlock Grid.Row="1" Text="Art / Rolle"/><TextBlock Grid.Row="1" Grid.Column="1"><Run Text="{Binding SelectedKind, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding SelectedRole, Mode=OneWay}"/></TextBlock>
                      <TextBlock Grid.Row="2" Text="Parent-ID"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedParent}" TextWrapping="Wrap"/>
                      <TextBlock Grid.Row="3" Text="Scope-ID / Zone"/><TextBlock Grid.Row="3" Grid.Column="1"><Run Text="{Binding SelectedScope, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding SelectedArea, Mode=OneWay}"/></TextBlock>
                      <TextBlock Grid.Row="4" Text="Capabilities"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedCapabilities}" TextWrapping="Wrap"/>
                    </Grid>
                  </Expander>
                </StackPanel></GroupBox>
                <GroupBox Header="Bearbeitung in Millimetern"><StackPanel IsEnabled="{Binding CanOperate}">
                  <TextBlock Text="Ebene"/><WrapPanel><Button Content="Element" Command="{Binding SetLayerCommand}" CommandParameter="element"/><Button Content="Text" Command="{Binding SetLayerCommand}" CommandParameter="text" IsEnabled="{Binding CanTextPosition}" Margin="6,0,0,0"/></WrapPanel>
                  <TextBlock Text="Modus" Margin="0,10,0,3"/><WrapPanel><Button Content="Position" Command="{Binding SetModeCommand}" CommandParameter="position" IsEnabled="{Binding CanPosition}"/><Button Content="Breite" Command="{Binding SetModeCommand}" CommandParameter="width" IsEnabled="{Binding CanWidth}"/><Button Content="Höhe" Command="{Binding SetModeCommand}" CommandParameter="height" IsEnabled="{Binding CanHeight}"/><Button Content="Textposition" Command="{Binding SetModeCommand}" CommandParameter="textPosition" IsEnabled="{Binding CanTextPosition}"/><Button Content="Schriftgröße" Command="{Binding SetModeCommand}" CommandParameter="fontSize" IsEnabled="{Binding CanFontSize}"/></WrapPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,10"><TextBlock Text="Schrittweite (mm)" VerticalAlignment="Center"/><TextBox Text="{Binding StepText, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="10,0,0,0"/></StackPanel>
                  <Grid HorizontalAlignment="Left"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="52"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Button Grid.Row="0" Grid.Column="1" Content="↑" Command="{Binding DirectionCommand}" CommandParameter="up"/><Button Grid.Row="1" Content="←" Command="{Binding DirectionCommand}" CommandParameter="left"/><Button Grid.Row="1" Grid.Column="2" Content="→" Command="{Binding DirectionCommand}" CommandParameter="right"/><Button Grid.Row="2" Grid.Column="1" Content="↓" Command="{Binding DirectionCommand}" CommandParameter="down"/></Grid>
                </StackPanel></GroupBox>
                <GroupBox Header="Weitere PDF-Eigenschaften"><StackPanel IsEnabled="{Binding CanOperate}">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="Ausrichtung:" Width="90"/><TextBlock Text="{Binding TextAlignment}" FontWeight="SemiBold"/></StackPanel>
                  <WrapPanel Margin="0,4,0,8"><Button Content="Links" Command="{Binding PropertyCommand}" CommandParameter="align:left" IsEnabled="{Binding CanTextAlignment}"/><Button Content="Zentriert" Command="{Binding PropertyCommand}" CommandParameter="align:center" IsEnabled="{Binding CanTextAlignment}"/><Button Content="Rechts" Command="{Binding PropertyCommand}" CommandParameter="align:right" IsEnabled="{Binding CanTextAlignment}"/></WrapPanel>
                  <StackPanel Orientation="Horizontal"><TextBlock Text="Zeilenabstand:" Width="90"/><TextBlock Text="{Binding LineSpacing}" FontWeight="SemiBold"/><Button Content="−" Command="{Binding PropertyCommand}" CommandParameter="lineSpacing-" IsEnabled="{Binding CanLineSpacing}" Margin="12,0,3,0"/><Button Content="+" Command="{Binding PropertyCommand}" CommandParameter="lineSpacing+" IsEnabled="{Binding CanLineSpacing}"/></StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="Sichtbarkeit:" Width="90"/><TextBlock Text="{Binding Visibility}" FontWeight="SemiBold"/><Button Content="Umschalten" Command="{Binding PropertyCommand}" CommandParameter="visibility" IsEnabled="{Binding CanVisibility}" Margin="12,0,0,0"/></StackPanel>
                  <TextBlock Text="Seitenränder (+/− Schrittweite)" Margin="0,10,0,3"/><WrapPanel><Button Content="Oben −" Command="{Binding PropertyCommand}" CommandParameter="marginTop-" IsEnabled="{Binding CanPageMargins}"/><Button Content="Oben +" Command="{Binding PropertyCommand}" CommandParameter="marginTop+" IsEnabled="{Binding CanPageMargins}"/><Button Content="Rechts −" Command="{Binding PropertyCommand}" CommandParameter="marginRight-" IsEnabled="{Binding CanPageMargins}"/><Button Content="Rechts +" Command="{Binding PropertyCommand}" CommandParameter="marginRight+" IsEnabled="{Binding CanPageMargins}"/><Button Content="Unten −" Command="{Binding PropertyCommand}" CommandParameter="marginBottom-" IsEnabled="{Binding CanPageMargins}"/><Button Content="Unten +" Command="{Binding PropertyCommand}" CommandParameter="marginBottom+" IsEnabled="{Binding CanPageMargins}"/><Button Content="Links −" Command="{Binding PropertyCommand}" CommandParameter="marginLeft-" IsEnabled="{Binding CanPageMargins}"/><Button Content="Links +" Command="{Binding PropertyCommand}" CommandParameter="marginLeft+" IsEnabled="{Binding CanPageMargins}"/></WrapPanel>
                </StackPanel></GroupBox>
                <GroupBox Header="PDF-Layoutaktionen"><WrapPanel><Button Content="Änderung verwerfen" Command="{Binding DiscardElementCommand}"/><Button Content="Alle Änderungen verwerfen" Command="{Binding DiscardAllCommand}"/><Button Content="Element zurücksetzen" Command="{Binding ResetElementCommand}"/><Button Content="Gesamtes PDF-Layout zurücksetzen" Command="{Binding ResetAllCommand}"/></WrapPanel></GroupBox>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,10,0,0"><StackPanel><TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold"/><TextBlock Text="{Binding ErrorMessage}" Foreground="#A61B1B" TextWrapping="Wrap"/><Expander Header="Details anzeigen"><Expander.Style><Style TargetType="Expander"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasTechnicalDetails}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Expander.Style><TextBlock Text="{Binding TechnicalDetails}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/></Expander></StackPanel></Border>
        </Grid>
        </Grid>
      </TabItem>
    </TabControl>
</Window>
