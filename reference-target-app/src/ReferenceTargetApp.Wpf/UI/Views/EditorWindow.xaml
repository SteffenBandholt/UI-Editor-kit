<Window x:Class="ReferenceTargetApp.UI.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UI-/PDF-Editor · Gemeinsamer End-to-End-Betrieb"
        Width="1380" Height="900" MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}">
    <TabControl SelectedIndex="{Binding ActiveWorkspaceIndex, Mode=TwoWay}" Margin="10">
      <TabItem Header="Programmoberfläche">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="220" /><ColumnDefinition Width="24" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Text="Profil:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="ProfileSelector" Grid.Column="1" ItemsSource="{Binding Profiles}" DisplayMemberPath="DisplayName" SelectedValuePath="ProfileId" SelectedValue="{Binding ActiveProfileId, Mode=OneWay}" SelectionChanged="ProfileSelector_SelectionChanged" />
                <TextBlock Grid.Column="3" Text="Bereich:" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="ScopeSelector" Grid.Column="4" ItemsSource="{Binding Scopes}" DisplayMemberPath="DisplayName" SelectedValuePath="ScopeId" SelectedValue="{Binding ActiveScopeId, Mode=OneWay}" SelectionChanged="ScopeSelector_SelectionChanged" />
                <TextBlock Grid.Column="5" Text="{Binding DirtyStatus}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#8A4B08" />
            </Grid>
        </Border>

        <GroupBox Grid.Row="1" Grid.Column="0" Header="Registrierte Elemente" Margin="0">
            <TreeView x:Name="ElementTree" ItemsSource="{Binding TreeRoots}" SelectedItemChanged="ElementTree_SelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=OneTime}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </GroupBox>

        <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Elementdetails">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Name" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Column="1" Text="{Binding SelectedName}" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="Element-ID" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedId}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Text="Art" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedType}" />
                        <TextBlock Grid.Row="3" Text="Scope" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedScope}" />
                        <TextBlock Grid.Row="4" Text="Parent" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedParent}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="5" Text="Rolle" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedRole}" />
                        <TextBlock Grid.Row="6" Text="Operationen" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Operations}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="7" Text="Position" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Position}" />
                        <TextBlock Grid.Row="8" Text="Größe" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Size}" />
                        <TextBlock Grid.Row="9" Text="Textposition" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding TextPosition}" />
                        <TextBlock Grid.Row="10" Text="Schriftgröße" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding FontSize}" />
                    </Grid>
                </GroupBox>

                <GroupBox Header="Bearbeitung">
                    <StackPanel IsEnabled="{Binding ControlsEnabled}">
                        <TextBlock Text="Ebene" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                        <ItemsControl ItemsSource="{Binding Layers}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" IsEnabled="{Binding Enabled}" Command="{Binding DataContext.SetLayerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Margin="0,0,8,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Active}" Value="True"><Setter Property="Background" Value="{StaticResource PrimaryBrush}" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Modus" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,5" />
                        <ItemsControl ItemsSource="{Binding Modes}" Margin="0,0,0,12">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" IsEnabled="{Binding Enabled}" Command="{Binding DataContext.SetModeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Id}" Margin="0,0,8,8"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Active}" Value="True"><Setter Property="Background" Value="{StaticResource PrimaryBrush}" /><Setter Property="Foreground" Value="White" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="Schrittweite (DIP)" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Text="{Binding StepText, UpdateSourceTrigger=PropertyChanged}" Width="110" />
                        </StackPanel>
                        <Grid HorizontalAlignment="Left">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="58" /><ColumnDefinition Width="58" /><ColumnDefinition Width="58" /></Grid.ColumnDefinitions>
                            <Button Grid.Row="0" Grid.Column="1" Content="↑" IsEnabled="{Binding UpEnabled}" Command="{Binding DirectionCommand}" CommandParameter="up" ToolTip="Nach oben / Höhe oder Schrift vergrößern" Margin="3" />
                            <Button Grid.Row="1" Grid.Column="0" Content="←" IsEnabled="{Binding LeftEnabled}" Command="{Binding DirectionCommand}" CommandParameter="left" ToolTip="Nach links / verkleinern" Margin="3" />
                            <Border Grid.Row="1" Grid.Column="1" Margin="8" Background="#E7EBF1" CornerRadius="4" />
                            <Button Grid.Row="1" Grid.Column="2" Content="→" IsEnabled="{Binding RightEnabled}" Command="{Binding DirectionCommand}" CommandParameter="right" ToolTip="Nach rechts / vergrößern" Margin="3" />
                            <Button Grid.Row="2" Grid.Column="1" Content="↓" IsEnabled="{Binding DownEnabled}" Command="{Binding DirectionCommand}" CommandParameter="down" ToolTip="Nach unten / Höhe oder Schrift verkleinern" Margin="3" />
                        </Grid>
                        <TextBlock Text="Schriftgröße: ← kleiner, → größer. Nicht verwendete Richtungen sind deaktiviert." Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Layoutaktionen">
                    <WrapPanel>
                        <Button Content="Speichern" Command="{Binding SaveCommand}" Margin="0,0,8,8" />
                        <Button Content="Laden" Command="{Binding LoadCommand}" Margin="0,0,8,8" />
                        <Button Content="Änderung verwerfen" Command="{Binding DiscardElementCommand}" ToolTip="Ausgewähltes Element zur letzten gespeicherten Profilversion zurück" Margin="0,0,8,8" />
                        <Button Content="Alle Änderungen verwerfen" Command="{Binding DiscardAllCommand}" ToolTip="Gesamtes Working-Layout zur letzten gespeicherten Profilversion zurück" Margin="0,0,8,8" />
                        <Button Content="Element zurücksetzen" Command="{Binding ResetElementCommand}" ToolTip="Ausgewähltes Element zur ursprünglichen Ziel-App-Baseline zurück" Margin="0,0,8,8" />
                        <Button Content="Gesamtes Layout zurücksetzen" Command="{Binding ResetAllCommand}" ToolTip="Alle Scopes zur ursprünglichen Ziel-App-Baseline zurück" Margin="0,0,8,8" />
                    </WrapPanel>
                </GroupBox>

                <GroupBox Header="Auswahl in der Ziel-App">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="In App auswählen" Command="{Binding BeginAppSelectionCommand}" Margin="0,0,8,0" />
                        <Button Content="Auswahl abbrechen" Command="{Binding CancelAppSelectionCommand}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#A61B1B" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding ErrorCodeDisplay}" Foreground="#A61B1B" FontSize="11" />
                </StackPanel>
                <Button Grid.Column="1" Content="Schließen" Command="{Binding CloseCommand}" MinWidth="110" Margin="18,0,0,0" />
            </Grid>
        </Border>
    </Grid>
      </TabItem>
      <TabItem Header="PDF-Ausgabe" DataContext="{Binding Pdf}">
        <Grid Margin="8">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="PDF-Profil:" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Grid.Column="1" Text="{Binding ProfileId}" FontWeight="SemiBold" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding DirtyStatus}" FontWeight="SemiBold" Margin="0,0,18,0"/><TextBlock Text="{Binding PreviewStatus}" FontWeight="SemiBold" Foreground="#8A4B08"/></StackPanel>
              <Button Grid.Column="3" Content="Speichern" Command="{Binding SaveCommand}" Margin="10,0,5,0"/>
              <Button Grid.Column="4" Content="Laden" Command="{Binding LoadCommand}" Margin="5,0"/>
              <Button Grid.Column="5" Content="PDF neu erzeugen" Command="{Binding RenderCommand}" Margin="5,0"/>
              <Button Grid.Column="6" Content="Vorschau aktualisieren" Command="{Binding RefreshPreviewCommand}" Margin="5,0,0,0"/>
            </Grid>
          </Border>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
              <Grid.RowDefinitions><RowDefinition Height="170"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <GroupBox Header="Seitenübersicht"><ListBox x:Name="PdfPageList" ItemsSource="{Binding Pages}" DisplayMemberPath="Label" SelectionChanged="PdfPageList_SelectionChanged"/></GroupBox>
              <GroupBox Grid.Row="2" Header="PDF-Elementbaum · 26 registrierte Elemente">
                <TreeView x:Name="PdfElementTree" ItemsSource="{Binding TreeRoots}" SelectedItemChanged="PdfElementTree_SelectedItemChanged">
                  <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="True"/></Style></TreeView.ItemContainerStyle>
                  <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}"><TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}"/></HierarchicalDataTemplate></TreeView.ItemTemplate>
                </TreeView>
              </GroupBox>
            </Grid>
            <GroupBox Grid.Column="2" Header="Native Vorschau · Seite einpassen">
              <Grid Background="#CBD1DA" ClipToBounds="True" x:Name="PdfPreviewViewport" SizeChanged="PdfPreviewViewport_SizeChanged" MouseLeftButtonDown="PdfPreviewViewport_MouseLeftButtonDown">
                <Border Background="White" BorderBrush="#707783" BorderThickness="1" Margin="14"><Image Source="{Binding SelectedPageImage}" Stretch="Uniform"/></Border>
                <Canvas IsHitTestVisible="False"><Rectangle Stroke="#E03030" StrokeThickness="2" Fill="#20E03030" Canvas.Left="{Binding OverlayLeft}" Canvas.Top="{Binding OverlayTop}" Width="{Binding OverlayWidth}" Height="{Binding OverlayHeight}"/></Canvas>
              </Grid>
            </GroupBox>
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
              <StackPanel>
                <GroupBox Header="PDF-Elementdetails"><Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                  <TextBlock Text="Name"/><TextBlock Grid.Column="1" Text="{Binding SelectedName}" FontWeight="SemiBold"/>
                  <TextBlock Grid.Row="1" Text="Element-ID"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedId}" TextWrapping="Wrap"/>
                  <TextBlock Grid.Row="2" Text="Art / Rolle"/><TextBlock Grid.Row="2" Grid.Column="1"><Run Text="{Binding SelectedKind, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding SelectedRole, Mode=OneWay}"/></TextBlock>
                  <TextBlock Grid.Row="3" Text="Parent"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedParent}" TextWrapping="Wrap"/>
                  <TextBlock Grid.Row="4" Text="Scope / Zone"/><TextBlock Grid.Row="4" Grid.Column="1"><Run Text="{Binding SelectedScope, Mode=OneWay}"/><Run Text=" / "/><Run Text="{Binding SelectedArea, Mode=OneWay}"/></TextBlock>
                  <TextBlock Grid.Row="5" Text="Capabilities"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedCapabilities}" TextWrapping="Wrap"/>
                  <TextBlock Grid.Row="6" Text="Position"/><TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding Position}"/>
                  <TextBlock Grid.Row="7" Text="Größe"/><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding Size}"/>
                  <TextBlock Grid.Row="8" Text="Textposition"/><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding TextPosition}"/>
                  <TextBlock Grid.Row="9" Text="Schriftgröße"/><TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding FontSize}"/>
                  <TextBlock Grid.Row="10" Text="Seite"/><TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding SelectedPageText}"/>
                  <TextBlock Grid.Row="11" Text="Tabelle"/><TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding TableInfo}" TextWrapping="Wrap"/>
                </Grid></GroupBox>
                <GroupBox Header="Bearbeitung in Millimetern"><StackPanel IsEnabled="{Binding CanOperate}">
                  <TextBlock Text="Ebene"/><WrapPanel><Button Content="Element" Command="{Binding SetLayerCommand}" CommandParameter="element"/><Button Content="Text" Command="{Binding SetLayerCommand}" CommandParameter="text" IsEnabled="{Binding CanTextPosition}" Margin="6,0,0,0"/></WrapPanel>
                  <TextBlock Text="Modus" Margin="0,10,0,3"/><WrapPanel><Button Content="Position" Command="{Binding SetModeCommand}" CommandParameter="position" IsEnabled="{Binding CanPosition}"/><Button Content="Breite" Command="{Binding SetModeCommand}" CommandParameter="width" IsEnabled="{Binding CanWidth}"/><Button Content="Höhe" Command="{Binding SetModeCommand}" CommandParameter="height" IsEnabled="{Binding CanHeight}"/><Button Content="Textposition" Command="{Binding SetModeCommand}" CommandParameter="textPosition" IsEnabled="{Binding CanTextPosition}"/><Button Content="Schriftgröße" Command="{Binding SetModeCommand}" CommandParameter="fontSize" IsEnabled="{Binding CanFontSize}"/></WrapPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,10"><TextBlock Text="Schrittweite (mm)" VerticalAlignment="Center"/><TextBox Text="{Binding StepText, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="10,0,0,0"/></StackPanel>
                  <Grid HorizontalAlignment="Left"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="52"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions><Button Grid.Row="0" Grid.Column="1" Content="↑" Command="{Binding DirectionCommand}" CommandParameter="up"/><Button Grid.Row="1" Content="←" Command="{Binding DirectionCommand}" CommandParameter="left"/><Button Grid.Row="1" Grid.Column="2" Content="→" Command="{Binding DirectionCommand}" CommandParameter="right"/><Button Grid.Row="2" Grid.Column="1" Content="↓" Command="{Binding DirectionCommand}" CommandParameter="down"/></Grid>
                </StackPanel></GroupBox>
                <GroupBox Header="PDF-Layoutaktionen"><WrapPanel><Button Content="Änderung verwerfen" Command="{Binding DiscardElementCommand}"/><Button Content="Alle Änderungen verwerfen" Command="{Binding DiscardAllCommand}"/><Button Content="Element zurücksetzen" Command="{Binding ResetElementCommand}"/><Button Content="Gesamtes PDF-Layout zurücksetzen" Command="{Binding ResetAllCommand}"/></WrapPanel></GroupBox>
              </StackPanel>
            </ScrollViewer>
          </Grid>
          <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,10,0,0"><StackPanel><TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold"/><TextBlock Text="{Binding ErrorMessage}" Foreground="#A61B1B" TextWrapping="Wrap"/><TextBlock Text="{Binding ErrorCodeDisplay}" Foreground="#A61B1B" FontSize="11"/></StackPanel></Border>
        </Grid>
      </TabItem>
    </TabControl>
</Window>
