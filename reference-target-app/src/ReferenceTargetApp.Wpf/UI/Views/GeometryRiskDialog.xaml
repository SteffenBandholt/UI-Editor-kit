<Window x:Class="ReferenceTargetApp.UI.Views.GeometryRiskDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Geometriehinweis" Width="620" SizeToContent="Height" MaxHeight="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}">
  <Border Margin="18" Padding="20" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8">
    <StackPanel>
      <TextBlock x:Name="TitleText" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="MessageText" Margin="0,12,0,0" FontSize="15" TextWrapping="Wrap"/>
      <TextBlock x:Name="ModeText" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
      <Expander Header="Details anzeigen" Margin="0,16,0,0">
        <Border Background="#F4F6F8" Padding="10" CornerRadius="4">
          <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="DetailsText" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/></ScrollViewer>
        </Border>
      </Expander>
      <WrapPanel x:Name="Actions" HorizontalAlignment="Right" Margin="0,20,0,0"/>
    </StackPanel>
  </Border>
</Window>
