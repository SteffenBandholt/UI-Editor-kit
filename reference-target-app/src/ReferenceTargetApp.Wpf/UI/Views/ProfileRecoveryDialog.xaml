<Window x:Class="ReferenceTargetApp.UI.Views.ProfileRecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gespeichertes Editorlayout ist nicht mehr kompatibel"
        Width="660" SizeToContent="Height" MinHeight="300" MaxHeight="620"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Gespeichertes Editorlayout ist nicht mehr kompatibel"
                   FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
        <StackPanel Grid.Row="1" Margin="0,14,0,0">
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
            <TextBlock x:Name="WorkspaceText" Margin="0,8,0,0" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <Button x:Name="DetailsButton" Content="Details anzeigen" HorizontalAlignment="Left"
                    MinWidth="120" Click="Details_Click" />
            <Border x:Name="DetailsPanel" Visibility="Collapsed" Margin="0,10,0,0" Padding="12"
                    BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Background="#F8FAFC">
                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DetailsText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>
        </StackPanel>
        <WrapPanel Grid.Row="3" Margin="0,18,0,0" HorizontalAlignment="Right">
            <Button x:Name="MigrateButton" Content="Profil migrieren und öffnen" MinWidth="185"
                    Margin="0,0,8,0" Click="Migrate_Click" />
            <Button Content="Mit Standardlayout öffnen" MinWidth="185" Margin="0,0,8,0"
                    Click="Baseline_Click" />
            <Button Content="Abbrechen" MinWidth="95" IsCancel="True" Click="Cancel_Click" />
        </WrapPanel>
    </Grid>
</Window>
