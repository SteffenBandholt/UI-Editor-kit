<UserControl x:Class="ReferenceTargetApp.UI.Views.CompactEditorWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="520" SizeChanged="Workspace_SizeChanged">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    <Style x:Key="SimpleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="MinHeight" Value="34"/><Setter Property="MinWidth" Value="42"/>
      <Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="0,0,7,7"/>
    </Style>
    <Style x:Key="PadButton" TargetType="Button" BasedOn="{StaticResource SimpleButton}">
      <Setter Property="Width" Value="52"/><Setter Property="Height" Value="42"/><Setter Property="FontSize" Value="20"/>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="12"/>
    </Style>
  </UserControl.Resources>

  <Grid Margin="10">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,9">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Einfachmodus" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding LastChangeSummary}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <WrapPanel Grid.Column="1" VerticalAlignment="Center">
          <Button Style="{StaticResource SimpleButton}" Content="Ziel in App auswählen" Command="{Binding BeginAppSelectionCommand}"/>
          <Button Style="{StaticResource SimpleButton}" Content="{Binding UndoLabel}" Command="{Binding UndoCommand}"/>
          <Button Style="{StaticResource SimpleButton}" Content="Speichern" Command="{Binding SaveCommand}"/>
        </WrapPanel>
      </Grid>
    </Border>

    <Grid x:Name="AdaptiveColumns" Grid.Row="1" ClipToBounds="True">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/></Grid.RowDefinitions>

      <Border x:Name="SelectionColumn" Grid.Column="0" Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="Auswahl" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding SelectedName}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding SelectionKindLabel}" Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold" Margin="0,3,0,10"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="{Binding SelectionContextLabel}" Foreground="{StaticResource MutedTextBrush}"/>
              <TextBlock Grid.Column="1" Text="{Binding SelectionContextValue}" TextWrapping="Wrap"/>
              <TextBlock Grid.Row="1" Text="Tabelle" Foreground="{StaticResource MutedTextBrush}" Visibility="{Binding IsTableTarget, Converter={StaticResource BoolToVisibility}}"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TableName}" Visibility="{Binding IsTableTarget, Converter={StaticResource BoolToVisibility}}"/>
              <TextBlock Grid.Row="2" Text="Spalte" Foreground="{StaticResource MutedTextBrush}" Visibility="{Binding IsTableTarget, Converter={StaticResource BoolToVisibility}}"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ColumnName}" TextWrapping="Wrap" Visibility="{Binding IsTableTarget, Converter={StaticResource BoolToVisibility}}"/>
            </Grid>
            <TextBlock Text="{Binding DirectSelectionInfo}" Margin="0,12,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>

            <Expander Header="Erweitert" IsExpanded="False" Margin="0,18,0,0">
              <StackPanel Margin="0,8,0,0">
                <TextBlock Text="Profil"/><ComboBox x:Name="CompactProfileSelector" ItemsSource="{Binding Profiles}" DisplayMemberPath="DisplayName" SelectedValuePath="ProfileId" SelectedValue="{Binding ActiveProfileId, Mode=OneWay}" SelectionChanged="ProfileSelector_SelectionChanged" Margin="0,3,0,8"/>
                <TextBlock Text="Bereich"/><ComboBox x:Name="CompactScopeSelector" ItemsSource="{Binding Scopes}" DisplayMemberPath="DisplayName" SelectedValuePath="ScopeId" SelectedValue="{Binding ActiveScopeId, Mode=OneWay}" SelectionChanged="ScopeSelector_SelectionChanged" Margin="0,3,0,8"/>
                <WrapPanel Margin="0,0,0,8"><RadioButton Content="Geführt" GroupName="AdvancedEditMode" IsChecked="{Binding IsGuidedEditMode, Mode=OneWay}" Command="{Binding SetEditModeCommand}" CommandParameter="guided" Margin="0,0,14,0"/><RadioButton Content="Frei" GroupName="AdvancedEditMode" IsChecked="{Binding IsFreeEditMode, Mode=OneWay}" Command="{Binding SetEditModeCommand}" CommandParameter="free"/></WrapPanel>
                <GroupBox Header="Elementbaum" MinHeight="190">
                  <TreeView x:Name="CompactElementTree" ItemsSource="{Binding TreeRoots}" SelectedItemChanged="ElementTree_SelectedItemChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <TreeView.ItemContainerStyle><Style TargetType="TreeViewItem"><Setter Property="IsExpanded" Value="True"/><Setter Property="IsSelected" Value="{Binding IsSelected, Mode=OneTime}"/></Style></TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate><HierarchicalDataTemplate ItemsSource="{Binding Children}"><TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis"/></HierarchicalDataTemplate></TreeView.ItemTemplate>
                  </TreeView>
                </GroupBox>
                <Expander Header="Technische Details" Margin="0,8,0,0">
                  <Expander Header="Details anzeigen">
                    <StackPanel><TextBlock Text="{Binding SelectedId, StringFormat=ID: {0}}" FontFamily="Consolas" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedType, StringFormat=Typ: {0}}"/><TextBlock Text="{Binding SelectedRole, StringFormat=Rolle: {0}}"/><TextBlock Text="{Binding SelectedParent, StringFormat=Parent: {0}}" FontFamily="Consolas" TextWrapping="Wrap"/><TextBlock Text="{Binding Operations, StringFormat=Operationen: {0}}" FontFamily="Consolas" TextWrapping="Wrap"/></StackPanel>
                  </Expander>
                </Expander>
              </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border x:Name="GeometryColumn" Grid.Column="1" Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel IsEnabled="{Binding ControlsEnabled}">
            <TextBlock Text="Bearbeiten" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <WrapPanel Margin="0,0,0,9">
              <RadioButton Content="Element" GroupName="SimpleLayer" IsChecked="{Binding IsSimpleElementLayer, Mode=OneWay}" Command="{Binding SimpleActionCommand}" CommandParameter="layer:element" Margin="0,0,18,0" Visibility="{Binding ShowSimpleElementLayer, Converter={StaticResource BoolToVisibility}}"/>
              <RadioButton Content="Text" GroupName="SimpleLayer" IsChecked="{Binding IsSimpleTextLayer, Mode=OneWay}" Command="{Binding SimpleActionCommand}" CommandParameter="layer:text" IsEnabled="{Binding CanSimpleText}"/>
            </WrapPanel>

            <StackPanel Visibility="{Binding IsSimpleElementLayer, Converter={StaticResource BoolToVisibility}}">
              <StackPanel Visibility="{Binding ShowSimpleMove, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Element verschieben" FontWeight="SemiBold"/>
              <Grid HorizontalAlignment="Left" Margin="0,5,0,9">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="56"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource PadButton}" Content="↑" Command="{Binding SimpleActionCommand}" CommandParameter="elementMove:up" IsEnabled="{Binding CanSimpleMove}"/>
                <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource PadButton}" Content="←" Command="{Binding SimpleActionCommand}" CommandParameter="elementMove:left" IsEnabled="{Binding CanSimpleMove}"/>
                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource PadButton}" Content="→" Command="{Binding SimpleActionCommand}" CommandParameter="elementMove:right" IsEnabled="{Binding CanSimpleMove}"/>
                <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource PadButton}" Content="↓" Command="{Binding SimpleActionCommand}" CommandParameter="elementMove:down" IsEnabled="{Binding CanSimpleMove}"/>
              </Grid>
              </StackPanel>
              <TextBlock Text="Größe" FontWeight="SemiBold" Visibility="{Binding ShowSimpleElementSize, Converter={StaticResource BoolToVisibility}}"/>
              <WrapPanel Margin="0,5,0,6" Visibility="{Binding ShowSimpleElementSize, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Breite" Width="56" VerticalAlignment="Center" Visibility="{Binding CanSimpleWidth, Converter={StaticResource BoolToVisibility}}"/><Button Style="{StaticResource SimpleButton}" Content="−" Command="{Binding SimpleActionCommand}" CommandParameter="elementWidth:left" IsEnabled="{Binding CanSimpleWidth}" Visibility="{Binding CanSimpleWidth, Converter={StaticResource BoolToVisibility}}"/><Button Style="{StaticResource SimpleButton}" Content="+" Command="{Binding SimpleActionCommand}" CommandParameter="elementWidth:right" IsEnabled="{Binding CanSimpleWidth}" Visibility="{Binding CanSimpleWidth, Converter={StaticResource BoolToVisibility}}"/><TextBlock Text="Höhe" Margin="10,0,6,7" VerticalAlignment="Center" Visibility="{Binding CanSimpleHeight, Converter={StaticResource BoolToVisibility}}"/><Button Style="{StaticResource SimpleButton}" Content="−" Command="{Binding SimpleActionCommand}" CommandParameter="elementHeight:up" IsEnabled="{Binding CanSimpleHeight}" Visibility="{Binding CanSimpleHeight, Converter={StaticResource BoolToVisibility}}"/><Button Style="{StaticResource SimpleButton}" Content="+" Command="{Binding SimpleActionCommand}" CommandParameter="elementHeight:down" IsEnabled="{Binding CanSimpleHeight}" Visibility="{Binding CanSimpleHeight, Converter={StaticResource BoolToVisibility}}"/></WrapPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding IsSimpleTextLayer, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Text/Anzeige verschieben" FontWeight="SemiBold" Visibility="{Binding CanSimpleDisplayMove, Converter={StaticResource BoolToVisibility}}"/>
              <Grid HorizontalAlignment="Left" Margin="0,5,0,8" Visibility="{Binding CanSimpleDisplayMove, Converter={StaticResource BoolToVisibility}}"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="56"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource PadButton}" Content="↑" Command="{Binding SimpleActionCommand}" CommandParameter="textMove:up" IsEnabled="{Binding CanSimpleDisplayMove}"/><Button Grid.Row="1" Grid.Column="0" Style="{StaticResource PadButton}" Content="←" Command="{Binding SimpleActionCommand}" CommandParameter="textMove:left" IsEnabled="{Binding CanSimpleDisplayMove}"/><Button Grid.Row="1" Grid.Column="2" Style="{StaticResource PadButton}" Content="→" Command="{Binding SimpleActionCommand}" CommandParameter="textMove:right" IsEnabled="{Binding CanSimpleDisplayMove}"/><Button Grid.Row="2" Grid.Column="1" Style="{StaticResource PadButton}" Content="↓" Command="{Binding SimpleActionCommand}" CommandParameter="textMove:down" IsEnabled="{Binding CanSimpleDisplayMove}"/>
              </Grid>
              <WrapPanel Visibility="{Binding ShowSimpleFontSize, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{Binding SimpleFontSizeLabel}" Width="170" VerticalAlignment="Center"/><Button Style="{StaticResource SimpleButton}" Content="Kleiner" Command="{Binding SimpleActionCommand}" CommandParameter="fontSize:left" IsEnabled="{Binding CanSimpleFontSize}"/><Button Style="{StaticResource SimpleButton}" Content="Größer" Command="{Binding SimpleActionCommand}" CommandParameter="fontSize:right" IsEnabled="{Binding CanSimpleFontSize}"/></WrapPanel>
            </StackPanel>

            <Button
              Style="{StaticResource SimpleButton}"
              Content="Unten zentrieren"
              Command="{Binding AlignBottomCenterCommand}"
              IsEnabled="{Binding CanSimpleMove}"
              Visibility="{Binding ShowSimpleMove, Converter={StaticResource BoolToVisibility}}"
              HorizontalAlignment="Left"
              Margin="0,4,0,4"/>

            <TextBlock Text="Schritt" FontWeight="SemiBold" Margin="0,5,0,5"/>
            <WrapPanel><Button Style="{StaticResource SimpleButton}" Content="1" Command="{Binding SetStepPresetCommand}" CommandParameter="1"/><Button Style="{StaticResource SimpleButton}" Content="5" Command="{Binding SetStepPresetCommand}" CommandParameter="5"/><Button Style="{StaticResource SimpleButton}" Content="10" Command="{Binding SetStepPresetCommand}" CommandParameter="10"/><TextBox Text="{Binding StepText, UpdateSourceTrigger=PropertyChanged}" Width="76" Height="31" VerticalContentAlignment="Center" ToolTip="Freie Schrittweite in DIP"/></WrapPanel>

            <Expander Header="Werte direkt eingeben (DIP)" Margin="0,7,0,0">
              <StackPanel Margin="0,7,0,0">
                <WrapPanel Visibility="{Binding ShowSimpleDirectPosition, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="X" Width="22" VerticalAlignment="Center"/><TextBox Text="{Binding DirectXText}" Width="68" Margin="0,0,4,6"/><Button Style="{StaticResource SimpleButton}" Content="Setzen" Command="{Binding ApplyDirectValueCommand}" CommandParameter="x" IsEnabled="{Binding CanSimpleMove}"/><TextBlock Text="Y" Width="22" VerticalAlignment="Center"/><TextBox Text="{Binding DirectYText}" Width="68" Margin="0,0,4,6"/><Button Style="{StaticResource SimpleButton}" Content="Setzen" Command="{Binding ApplyDirectValueCommand}" CommandParameter="y" IsEnabled="{Binding CanSimpleMove}"/></WrapPanel>
                <WrapPanel Visibility="{Binding ShowSimpleDirectSize, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="B" Width="22" VerticalAlignment="Center" Visibility="{Binding CanSimpleWidth, Converter={StaticResource BoolToVisibility}}"/><TextBox Text="{Binding DirectWidthText}" Width="68" Margin="0,0,4,6" Visibility="{Binding CanSimpleWidth, Converter={StaticResource BoolToVisibility}}"/><Button Style="{StaticResource SimpleButton}" Content="Setzen" Command="{Binding ApplyDirectValueCommand}" CommandParameter="width" IsEnabled="{Binding CanSimpleWidth}" Visibility="{Binding CanSimpleWidth, Converter={StaticResource BoolToVisibility}}"/><TextBlock Text="H" Width="22" VerticalAlignment="Center" Visibility="{Binding CanSimpleHeight, Converter={StaticResource BoolToVisibility}}"/><TextBox Text="{Binding DirectHeightText}" Width="68" Margin="0,0,4,6" Visibility="{Binding CanSimpleHeight, Converter={StaticResource BoolToVisibility}}"/><Button Style="{StaticResource SimpleButton}" Content="Setzen" Command="{Binding ApplyDirectValueCommand}" CommandParameter="height" IsEnabled="{Binding CanSimpleHeight}" Visibility="{Binding CanSimpleHeight, Converter={StaticResource BoolToVisibility}}"/></WrapPanel>
                <WrapPanel Visibility="{Binding ShowSimpleDirectTextPosition, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Text X" Width="48" VerticalAlignment="Center"/><TextBox Text="{Binding DirectTextXText}" Width="68" Margin="0,0,4,6"/><Button Style="{StaticResource SimpleButton}" Content="Setzen" Command="{Binding ApplyDirectValueCommand}" CommandParameter="textX" IsEnabled="{Binding CanSimpleTextMove}"/><TextBlock Text="Text Y" Width="48" VerticalAlignment="Center"/><TextBox Text="{Binding DirectTextYText}" Width="68" Margin="0,0,4,6"/><Button Style="{StaticResource SimpleButton}" Content="Setzen" Command="{Binding ApplyDirectValueCommand}" CommandParameter="textY" IsEnabled="{Binding CanSimpleTextMove}"/></WrapPanel>
                <WrapPanel Visibility="{Binding ShowSimpleDirectFontSize, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Schrift" Width="48" VerticalAlignment="Center"/><TextBox Text="{Binding DirectFontSizeText}" Width="68" Margin="0,0,4,6" IsEnabled="{Binding CanSimpleFontSize}"/><Button Style="{StaticResource SimpleButton}" Content="Setzen" Command="{Binding ApplyDirectValueCommand}" CommandParameter="fontSize" IsEnabled="{Binding CanSimpleFontSize}"/></WrapPanel>
              </StackPanel>
            </Expander>
            <WrapPanel Margin="0,12,0,0"><Button Style="{StaticResource SimpleButton}" Content="Original" Command="{Binding SimpleActionCommand}" CommandParameter="original" IsEnabled="{Binding CanResetElement}"/><Button Style="{StaticResource SimpleButton}" Content="{Binding VisibilityActionLabel}" Command="{Binding SimpleActionCommand}" CommandParameter="visibility" IsEnabled="{Binding CanChangeVisibility}" Visibility="{Binding ShowSimpleVisibility, Converter={StaticResource BoolToVisibility}}"/></WrapPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border x:Name="GroupColumn" Grid.Column="2" Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <TextBlock Text="Tabelle und Abschluss" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <Border Visibility="{Binding IsTableTarget, Converter={StaticResource BoolToVisibility}}" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="5" Padding="9">
              <StackPanel>
                <TextBlock Text="{Binding TableEditorTitle}" FontWeight="SemiBold" FontSize="15"/>
                <TextBlock Text="{Binding TableGeometryStatus}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                <StackPanel Visibility="{Binding HasTableOverview, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="Spalten von links nach rechts" FontWeight="SemiBold" Margin="0,2,0,5"/>
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding TableColumns}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate><DataTemplate>
                        <Border Width="{Binding PreviewWidth}" MinWidth="28" Background="#FFFFFF" BorderBrush="#2563EB" BorderThickness="1" Padding="5" Margin="0,0,-1,0">
                          <StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/><TextBlock Text="{Binding WidthLabel}" Foreground="#334155" TextWrapping="Wrap" ToolTip="{Binding RuntimeLabel}"/></StackPanel>
                        </Border>
                      </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <ItemsControl ItemsSource="{Binding TableColumns}" Margin="0,7,0,4">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Grid Margin="0,1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                        <StackPanel Grid.Column="1" Margin="8,0"><TextBlock Text="{Binding WidthLabel}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding RuntimeLabel}" Foreground="#64748B" TextWrapping="Wrap"/></StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding LimitsLabel}" Foreground="#64748B"/>
                      </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Separator Margin="0,5"/>
                  <TextBlock Text="Spaltengrenze verschieben" FontWeight="SemiBold"/>
                  <ListBox ItemsSource="{Binding TableBoundaries}" SelectedItem="{Binding SelectedTableBoundary, Mode=TwoWay}" DisplayMemberPath="DisplayName" Margin="0,5,0,4" MaxHeight="66"/>
                  <TextBlock Text="{Binding SelectedTableBoundary.PositionLabel}" Foreground="#475569"/>
                  <WrapPanel Margin="0,5,0,4">
                    <TextBlock Text="Schritt (DIP)" VerticalAlignment="Center" Margin="0,0,6,7"/>
                    <TextBox Text="{Binding StepText, UpdateSourceTrigger=PropertyChanged}" Width="64" Height="31" Margin="0,0,6,7"/>
                    <Button Style="{StaticResource SimpleButton}" Content="←" ToolTip="Grenze nach links" AutomationProperties.Name="Spaltengrenze nach links" Command="{Binding MoveTableBoundaryCommand}" CommandParameter="left" IsEnabled="{Binding CanMoveTableBoundary}"/>
                    <Button Style="{StaticResource SimpleButton}" Content="→" ToolTip="Grenze nach rechts" AutomationProperties.Name="Spaltengrenze nach rechts" Command="{Binding MoveTableBoundaryCommand}" CommandParameter="right" IsEnabled="{Binding CanMoveTableBoundary}"/>
                    <Button Style="{StaticResource SimpleButton}" Content="Tabelle Original" Command="{Binding TableCommand}" CommandParameter="resetTable"/>
                  </WrapPanel>
                  <TextBlock Text="Links wird um denselben Betrag breiter, rechts schmaler. Die Tabellenbreite bleibt unverändert." Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,7"/>
                </StackPanel>
                <Button Style="{StaticResource SimpleButton}" Content="Ganze Spalte auswählen" Command="{Binding SelectWholeColumnCommand}" Visibility="{Binding CanSelectWholeColumn, Converter={StaticResource BoolToVisibility}}"/>
                <WrapPanel Visibility="{Binding IsTableColumn, Converter={StaticResource BoolToVisibility}}"><Button Style="{StaticResource SimpleButton}" Content="−10" Command="{Binding SimpleActionCommand}" CommandParameter="column:-10"/><Button Style="{StaticResource SimpleButton}" Content="−1" Command="{Binding SimpleActionCommand}" CommandParameter="column:-1"/><Button Style="{StaticResource SimpleButton}" Content="+1" Command="{Binding SimpleActionCommand}" CommandParameter="column:1"/><Button Style="{StaticResource SimpleButton}" Content="+10" Command="{Binding SimpleActionCommand}" CommandParameter="column:10"/></WrapPanel>
                <WrapPanel Visibility="{Binding IsTableColumn, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="Gespeicherter Wert" VerticalAlignment="Center" Margin="0,0,6,7"/><TextBox Text="{Binding ColumnWidthText, UpdateSourceTrigger=PropertyChanged}" Width="78" Height="31" Margin="0,0,6,7"/><Button Style="{StaticResource SimpleButton}" Content="Setzen" Command="{Binding ApplyColumnWidthCommand}"/><Button Style="{StaticResource SimpleButton}" Content="Umbruch" Command="{Binding SimpleActionCommand}" CommandParameter="columnWrap"/><Button Style="{StaticResource SimpleButton}" Content="Ellipsis" Command="{Binding SimpleActionCommand}" CommandParameter="columnEllipsis"/><Button Style="{StaticResource SimpleButton}" Content="Original" Command="{Binding SimpleActionCommand}" CommandParameter="columnOriginal"/></WrapPanel>
                <TextBlock Text="{Binding ColumnWidthInputStatus}" Visibility="{Binding IsTableColumn, Converter={StaticResource BoolToVisibility}}" Foreground="#475569" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Button Style="{StaticResource SimpleButton}" Content="Tabelle in sichtbaren Bereich einpassen" Command="{Binding SimpleActionCommand}" CommandParameter="tableFit"/>
              </StackPanel>
            </Border>
            <TextBlock Text="Wählen Sie eine registrierte Tabellenspalte, um ihre Breite zu bearbeiten." Visibility="{Binding IsTableTarget, Converter={StaticResource BoolToVisibility}}" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>

            <Expander Header="Erweiterte Layoutfunktionen" IsExpanded="False" Margin="0,15,0,0">
              <StackPanel Margin="0,8,0,0">
                <TextBlock Text="{Binding EditModeStatus}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding LayoutEffectInfo}" TextWrapping="Wrap" Margin="0,5,0,8"/>
                <ItemsControl ItemsSource="{Binding Modes}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource SimpleButton}" Content="{Binding Label}" IsEnabled="{Binding Enabled}" Command="{Binding DataContext.SetModeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Id}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="{Binding SpacingStatus}" TextWrapping="Wrap" Margin="0,6,0,5"/>
                <WrapPanel Visibility="{Binding CanBeforeElement, Converter={StaticResource BoolToVisibility}}"><Button Style="{StaticResource SimpleButton}" Content="Spacer davor −" Command="{Binding SpacingCommand}" CommandParameter="beforeElement:decrease"/><Button Style="{StaticResource SimpleButton}" Content="Spacer davor +" Command="{Binding SpacingCommand}" CommandParameter="beforeElement:increase"/><Button Style="{StaticResource SimpleButton}" Content="Spacer Original" Command="{Binding SpacingCommand}" CommandParameter="beforeElement:reset"/></WrapPanel>
                <WrapPanel Visibility="{Binding CanAfterElement, Converter={StaticResource BoolToVisibility}}"><Button Style="{StaticResource SimpleButton}" Content="Spacer danach −" Command="{Binding SpacingCommand}" CommandParameter="afterElement:decrease"/><Button Style="{StaticResource SimpleButton}" Content="Spacer danach +" Command="{Binding SpacingCommand}" CommandParameter="afterElement:increase"/><Button Style="{StaticResource SimpleButton}" Content="Spacer Original" Command="{Binding SpacingCommand}" CommandParameter="afterElement:reset"/></WrapPanel>
                <WrapPanel Visibility="{Binding CanGroupPaddingLeft, Converter={StaticResource BoolToVisibility}}"><Button Style="{StaticResource SimpleButton}" Content="Innen links −" Command="{Binding SpacingCommand}" CommandParameter="groupPaddingLeft:decrease"/><Button Style="{StaticResource SimpleButton}" Content="Innen links +" Command="{Binding SpacingCommand}" CommandParameter="groupPaddingLeft:increase"/></WrapPanel>
                <WrapPanel Visibility="{Binding CanGroupPaddingRight, Converter={StaticResource BoolToVisibility}}"><Button Style="{StaticResource SimpleButton}" Content="Innen rechts −" Command="{Binding SpacingCommand}" CommandParameter="groupPaddingRight:decrease"/><Button Style="{StaticResource SimpleButton}" Content="Innen rechts +" Command="{Binding SpacingCommand}" CommandParameter="groupPaddingRight:increase"/></WrapPanel>
                <WrapPanel Visibility="{Binding CanGroupPaddingTop, Converter={StaticResource BoolToVisibility}}"><Button Style="{StaticResource SimpleButton}" Content="Innen oben −" Command="{Binding SpacingCommand}" CommandParameter="groupPaddingTop:decrease"/><Button Style="{StaticResource SimpleButton}" Content="Innen oben +" Command="{Binding SpacingCommand}" CommandParameter="groupPaddingTop:increase"/></WrapPanel>
                <WrapPanel Visibility="{Binding CanGroupPaddingBottom, Converter={StaticResource BoolToVisibility}}"><Button Style="{StaticResource SimpleButton}" Content="Innen unten −" Command="{Binding SpacingCommand}" CommandParameter="groupPaddingBottom:decrease"/><Button Style="{StaticResource SimpleButton}" Content="Innen unten +" Command="{Binding SpacingCommand}" CommandParameter="groupPaddingBottom:increase"/></WrapPanel>
                <WrapPanel Visibility="{Binding CanChildGapHorizontal, Converter={StaticResource BoolToVisibility}}"><Button Style="{StaticResource SimpleButton}" Content="Kindabstand horizontal −" Command="{Binding SpacingCommand}" CommandParameter="childGapHorizontal:decrease"/><Button Style="{StaticResource SimpleButton}" Content="Kindabstand horizontal +" Command="{Binding SpacingCommand}" CommandParameter="childGapHorizontal:increase"/></WrapPanel>
                <WrapPanel Visibility="{Binding CanChildGapVertical, Converter={StaticResource BoolToVisibility}}"><Button Style="{StaticResource SimpleButton}" Content="Kindabstand vertikal −" Command="{Binding SpacingCommand}" CommandParameter="childGapVertical:decrease"/><Button Style="{StaticResource SimpleButton}" Content="Kindabstand vertikal +" Command="{Binding SpacingCommand}" CommandParameter="childGapVertical:increase"/></WrapPanel>
                <WrapPanel><Button Style="{StaticResource SimpleButton}" Content="Verwerfen" Command="{Binding DiscardElementCommand}"/><Button Style="{StaticResource SimpleButton}" Content="Laden" Command="{Binding LoadCommand}"/><Button Style="{StaticResource SimpleButton}" Content="Alle verwerfen" Command="{Binding DiscardAllCommand}"/><Button Style="{StaticResource SimpleButton}" Content="Gesamtreset" Command="{Binding ResetAllCommand}"/></WrapPanel>
                <WrapPanel Visibility="{Binding IsTableLayout, Converter={StaticResource BoolToVisibility}}"><Button Style="{StaticResource SimpleButton}" Content="Fit mit Vorschau" Command="{Binding TableCommand}" CommandParameter="fitTableToViewport"/><Button Style="{StaticResource SimpleButton}" Content="Horizontal scrollen" Command="{Binding TableCommand}" CommandParameter="setHorizontalOverflowMode:scroll"/><Button Style="{StaticResource SimpleButton}" Content="Viewport begrenzen" Command="{Binding TableCommand}" CommandParameter="setHorizontalOverflowMode:fitViewport"/><Button Style="{StaticResource SimpleButton}" Content="Tabelle Original" Command="{Binding TableCommand}" CommandParameter="resetTable"/></WrapPanel>
                <WrapPanel Visibility="{Binding IsTableColumn, Converter={StaticResource BoolToVisibility}}"><Button Style="{StaticResource SimpleButton}" Content="Schmaler" Command="{Binding TableCommand}" CommandParameter="columnWidth:decrease"/><Button Style="{StaticResource SimpleButton}" Content="Breiter" Command="{Binding TableCommand}" CommandParameter="columnWidth:increase"/><Button Style="{StaticResource SimpleButton}" Content="Mindestbreite" Command="{Binding TableCommand}" CommandParameter="columnWidth:minimum"/><Button Style="{StaticResource SimpleButton}" Content="Maximalbreite" Command="{Binding TableCommand}" CommandParameter="columnWidth:maximum"/><Button Style="{StaticResource SimpleButton}" Content="Nur gewählte Spalte einpassen" Command="{Binding TableCommand}" CommandParameter="fitSelectedColumn"/><Button Style="{StaticResource SimpleButton}" Content="Breite fest" Command="{Binding TableCommand}" CommandParameter="setColumnWidthMode:fixed"/><Button Style="{StaticResource SimpleButton}" Content="Breite automatisch" Command="{Binding TableCommand}" CommandParameter="setColumnWidthMode:auto"/><Button Style="{StaticResource SimpleButton}" Content="Breite proportional" Command="{Binding TableCommand}" CommandParameter="setColumnWidthMode:proportional"/><Button Style="{StaticResource SimpleButton}" Content="Zeichenumbruch" Command="{Binding TableCommand}" CommandParameter="setColumnWrapMode:characterWrap"/><Button Style="{StaticResource SimpleButton}" Content="Kein Umbruch" Command="{Binding TableCommand}" CommandParameter="setColumnWrapMode:noWrap"/><Button Style="{StaticResource SimpleButton}" Content="Überlauf Ellipsis" Command="{Binding TableCommand}" CommandParameter="setColumnOverflowMode:ellipsis"/><Button Style="{StaticResource SimpleButton}" Content="Überlauf abschneiden" Command="{Binding TableCommand}" CommandParameter="setColumnOverflowMode:clip"/></WrapPanel>
              </StackPanel>
            </Expander>
            <Separator Margin="0,14,0,10"/>
            <TextBlock Text="{Binding DirtyStatus}" FontWeight="SemiBold" Foreground="#8A4B08"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,9,0,0" Padding="9">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding ErrorMessage}" Foreground="#A61B1B" TextWrapping="Wrap"/><Expander Header="Details anzeigen" Visibility="{Binding HasTechnicalDetails, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="{Binding TechnicalDetails}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/></Expander></StackPanel>
        <Button Grid.Column="1" Content="Schließen" Command="{Binding CloseCommand}" MinWidth="90" Margin="9,0,0,0"/>
      </Grid>
    </Border>
  </Grid>
</UserControl>
