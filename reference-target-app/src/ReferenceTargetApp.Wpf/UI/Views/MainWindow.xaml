<Window x:Class="ReferenceTargetApp.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auftragsverwaltung – Referenz-Ziel-App"
        Width="1180" Height="780" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#162A46" Padding="26,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="AUFTRAGSVERWALTUNG" Foreground="#AFC9EA" FontSize="11" FontWeight="SemiBold" />
                    <TextBlock Text="Auftrag bearbeiten" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                </StackPanel>
                <Button x:Name="OpenEditorButton" Grid.Column="1" Content="UI bearbeiten" Click="OpenEditor_Click" Margin="0,0,14,0" Background="#F5F8FC" Foreground="#162A46" VerticalAlignment="Center" />
                <Border x:Name="OrderStatusIndicator" Grid.Column="2" Background="#274A76" CornerRadius="16" Padding="14,7" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="#65D49A" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding StatusLabel}" Foreground="White" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,20,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <GroupBox x:Name="OrderHeaderScope" Header="Auftragskopf">
                        <Grid x:Name="OrderHeaderCoreGroup">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Auftragsnummer" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="OrderNumberInput" Text="{Binding OrderNumber}" />
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="Auftragsdatum" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="OrderDateInput" Text="{Binding OrderDate}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                                <TextBlock Text="Betreff" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="SubjectInput" Text="{Binding Subject}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Verantwortlich" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="ResponsiblePersonInput" Text="{Binding ResponsiblePerson}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Fällig am" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="DueDateInput" Text="{Binding DueDate}" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox x:Name="CustomerDataGroup" Header="Kundendaten">
                        <Grid x:Name="CustomerDetailsCoreGroup">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
                                <TextBlock Text="Unternehmen" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="CompanyNameInput" Text="{Binding CompanyName}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,12">
                                <TextBlock Text="Ansprechperson" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="ContactNameInput" Text="{Binding ContactName}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,12">
                                <TextBlock Text="E-Mail" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="EmailInput" Text="{Binding Email}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Straße" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="StreetInput" Text="{Binding Street}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="PLZ / Ort" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="PostalCityInput" Text="{Binding PostalCity}" />
                            </StackPanel>
                            <Button x:Name="CheckCustomerButton" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                    Content="Kundendaten prüfen" Click="CheckCustomer_Click" Margin="0,12,0,0" />
                        </Grid>
                    </GroupBox>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2">
                    <GroupBox x:Name="BusinessActionsGroup" Header="Status und Aktionen">
                        <StackPanel>
                            <TextBlock Text="Bearbeitungsstatus" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,4" />
                            <ComboBox SelectedIndex="1" Margin="0,0,0,18">
                                <ComboBoxItem Content="Entwurf" />
                                <ComboBoxItem Content="In Prüfung" />
                                <ComboBoxItem Content="Freigegeben" />
                            </ComboBox>
                            <Button x:Name="NewOrderButton" Content="Neuen Beispielauftrag anlegen" Click="NewOrder_Click" Margin="0,0,0,8" />
                            <Button x:Name="AddPositionButton" Content="Position hinzufügen" Click="AddPosition_Click" Margin="0,0,0,8" />
                            <Button x:Name="CheckOrderButton" Content="Auftrag prüfen" Click="CheckOrder_Click" Margin="0,0,0,8" />
                            <Button x:Name="SaveOrderButton" Content="Im Arbeitsspeicher sichern" Click="SaveOrder_Click" Background="{StaticResource PrimaryBrush}" Foreground="White" />
                            <TextBlock Text="Fachliche Beispielaktionen – keine Editorsteuerung" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox x:Name="TotalsGroup" Header="Summen">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="30" />
                                <RowDefinition Height="30" />
                                <RowDefinition Height="42" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Nettosumme" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding NetTotal, StringFormat={}{0:N2} €}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Text="{Binding TaxLabel}" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TaxAmount, StringFormat={}{0:N2} €}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Grid.Row="2" Grid.ColumnSpan="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,4,0,0" />
                            <TextBlock Grid.Row="2" Text="Gesamtsumme" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding GrossTotal, StringFormat={}{0:N2} €}" Foreground="{StaticResource PrimaryBrush}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                        </Grid>
                    </GroupBox>
                </StackPanel>

                <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Header="Positionen" Margin="0,2,0,0">
                    <DataGrid x:Name="PositionsTable" ItemsSource="{Binding Positions}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="34"
                              BorderThickness="0" Background="White" AlternatingRowBackground="#F7F9FC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Pos." Binding="{Binding PositionNumber}" Width="70" />
                            <DataGridTextColumn Header="Beschreibung" Binding="{Binding Description}" Width="*" />
                            <DataGridTextColumn Header="Menge" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="90" />
                            <DataGridTextColumn Header="Einheit" Binding="{Binding Unit}" Width="90" />
                            <DataGridTextColumn Header="Einzelpreis" Binding="{Binding UnitPrice, StringFormat={}{0:N2} €}" Width="130" />
                            <DataGridTextColumn Header="Gesamt" Binding="{Binding NetAmount, StringFormat={}{0:N2} €}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#E7EBF1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" Fill="#2FA36B" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding ActivityMessage}" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" />
                <TextBlock Grid.Column="2" Text="M75 · Vollständiger nativer UI-Betrieb" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
            </Grid>
        </Border>
    </Grid>
</Window>
