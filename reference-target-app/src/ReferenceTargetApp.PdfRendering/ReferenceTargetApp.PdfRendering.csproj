<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>ReferenceTargetApp.PdfRendering</RootNamespace>
    <Description>Technical PDFsharp rendering boundary for the reference target application.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp 6.2.4 requests vulnerable Pkcs 8.0.1. Pin the compatible
         net10 security patch for GHSA-2fmv-rv2c-59x7 and GHSA-846f-f764-76mx. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ReferenceTargetApp.Domain/ReferenceTargetApp.Domain.csproj" />
    <ProjectReference Include="../ReferenceTargetApp.EditorIntegration/ReferenceTargetApp.EditorIntegration.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ReferenceTargetApp.Tests" />
  </ItemGroup>
</Project>
